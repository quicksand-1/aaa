{
  "name": "business-workbench-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backup": "node scripts/backup-sqlite.js",
    "clean": "ets clean",
    "clean:js": "node scripts/clean-js.js",
    "create-admin": "node -r ts-node/register/transpile-only scripts/create-admin.ts",
    "dev": "npm run clean:js && egg-bin dev",
    "migrate": "node scripts/reconcile-migrations.js && node -r ts-node/register/transpile-only ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "node -r ts-node/register/transpile-only ./node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "migrate:test": "NODE_ENV=unittest node -r ts-node/register/transpile-only ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "prepare:test-db": "node scripts/prepare-test-db.js",
    "start": "egg-scripts start --title=business-workbench --workers=1 --daemon=false",
    "stop": "egg-scripts stop --title=business-workbench",
    "test": "npm run typecheck && npm run clean:js && npm run prepare:test-db && npm run migrate:test && egg-bin test",
    "test-local": "npm run clean:js && egg-bin test",
    "tsc": "ets && tsc -p tsconfig.json",
    "typecheck": "ets && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.6.1",
    "egg": "^3.34.0",
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@eggjs/tsconfig": "^3.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "egg-bin": "^6.13.0",
    "egg-mock": "^5.15.2",
    "egg-scripts": "^3.1.0",
    "egg-ts-helper": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "egg": {
    "typescript": true,
    "declarations": true
  }
}

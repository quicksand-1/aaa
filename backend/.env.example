NODE_ENV=development
PORT=7001
HOST=127.0.0.1
APP_KEYS=请替换为随机字符串
# 数据库文件路径；不填时使用 backend/storage/dev.sqlite
DB_FILE=
# 额外放行的来源主机名（不含协议和端口）；同源请求自动放行
ORIGIN_WHITELIST=localhost,127.0.0.1
# 可选：手机扫码访问地址；不填时 localhost 会自动替换为局域网 IPv4
MOBILE_QR_BASE_URL=
# 微信小程序服务端配置，appSecret 只放在后端环境
# 重要：当前“深维”小程序使用独立 AppSecret。开发其他小程序时必须换成对应
# 小程序的 AppID 和 AppSecret，禁止跨产品复用。
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
